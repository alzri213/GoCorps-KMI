APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SQL Server connections (edit and copy to .env) -------------------------

# Primary auth DB (GoCorps)
# DB_AUTH_CONNECTION=gocorps
# GOCORPS_DB_HOST=127.0.0.1
# GOCORPS_DB_PORT=1433
# GOCORPS_DB_DATABASE=GoCorps_DEV
# GOCORPS_DB_USERNAME=sa
# GOCORPS_DB_PASSWORD=your_password

# Company Portal DB (roles / auth metadata)
# COMPANY_DB_CONNECTION=company_portal
# COMPANY_DB_HOST=127.0.0.1
# COMPANY_DB_PORT=1433
# COMPANY_DB_DATABASE=CompanyPortal_DEV
# COMPANY_DB_USERNAME=sa
# COMPANY_DB_PASSWORD=your_password

# Example: Windows SQL Server named instance on developer machine
# Replace the values in your real .env (remove leading #). If your SQL Server
# uses a named instance (e.g. Zreekx\SQLEXPRESS) set the host like below.
# COMPANY_DB_HOST=Zreekx\\SQLEXPRESS
# GOCORPS_DB_HOST=Zreekx\\SQLEXPRESS
# If you prefer a single URL style (may be optional), you can set:
# COMPANY_DB_URL=sqlsrv://sa:YourPass@Zreekx\\SQLEXPRESS;database=CompanyPortal_DEV
# GOCORPS_DB_URL=sqlsrv://sa:YourPass@Zreekx\\SQLEXPRESS;database=GoCorps_DEV

# If the Company Portal stores roles in a different table/column, set these:
# COMPANY_ROLE_TABLE=AdminUserAccount
# COMPANY_ROLE_USER_COLUMN=email
# COMPANY_ROLE_COLUMN=role
